# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)
#
# DEVELOPMENT vs PRODUCTION:
# - Dev (docker-compose.yml): Direct port access, no Traefik
#   - Dashboard: http://localhost:5173
#   - API: http://localhost:8000
#   - PostgreSQL: localhost:5432 (for external Grafana connection)
#
# - Prod (docker-compose.prod.yml): Traefik reverse proxy with HTTPS
#   - Dashboard: https://bot.yourdomain.com
#   - API: https://api.yourdomain.com
#   - PostgreSQL: <server-ip>:5432 (for external Grafana connection)
#
# NOTE: Grafana is now hosted externally on a separate server for multi-project monitoring.

# ==========================================
# GENERAL
# ==========================================
ENVIRONMENT=dev  # dev, staging, prod

# Use in docker-compose.prod.yml to retrieve data.
GITHUB_USERNAME=username

# ==========================================
# DATABASE (PostgreSQL + TimescaleDB)
# ==========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trader_bot
POSTGRES_USER=trader

# CRITICAL: Generate strong password before production deployment
# Production requires >= 16 characters, no weak patterns
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=change_me_in_production

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Dedicated SELECT-only role for the external Grafana connection. Created by the
# Alembic migration; Grafana must connect with THIS role, never POSTGRES_USER, so
# a Grafana credential leak cannot write to control tables like run_commands.
# If left empty the role is created with NOLOGIN (set a password later to enable).
POSTGRES_GRAFANA_READONLY_USER=grafana_readonly
POSTGRES_GRAFANA_READONLY_PASSWORD=

# TimescaleDB settings
TIMESCALEDB_TELEMETRY=off

# ==========================================
# BINANCE EXCHANGE
# ==========================================
# Toggle between testnet and mainnet
BINANCE_TESTNET=true

# API credentials (testnet - Binance Spot Test Network)
BINANCE_TESTNET_API_KEY=your_testnet_api_key
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret

# API credentials (mainnet) - ONLY for production
BINANCE_MAINNET_API_KEY=your_mainnet_api_key
BINANCE_MAINNET_API_SECRET=your_mainnet_api_secret

# Trading parameters
# USDC only (USDT is not authorised in the EU).
BINANCE_DEFAULT_SYMBOL=BTCUSDC
BINANCE_DEFAULT_TIMEFRAME=15m
# Symbols offered in the dashboard's "start a run" combo box (comma-separated,
# USDC quote, first entry is the default). Also enforced server-side and by the
# bot supervisor. Add more as data becomes available, e.g. BTCUSDC,ETHUSDC.
AVAILABLE_SYMBOLS=BTCUSDC
BINANCE_MAX_SLIPPAGE_PERCENT=0.2
BINANCE_ORDER_TIMEOUT_SECONDS=1800  # 30 minutes

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================

# CRITICAL: Generate strong secrets before production deployment
# The application will REJECT weak secrets in production (ENVIRONMENT=prod)

# JWT secret key
# Production requires >= 32 characters, no weak patterns (change_me, admin, password, etc.)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_secure_random_key_here

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Authentication mode:
#   local         -> built-in JWT-cookie login (mono-user). The ONLY mode usable
#                    in dev (Authelia needs TLS certs that can't be provisioned locally).
#   authelia_oidc -> Authelia (auth.trader.derveloy.eu) as an OIDC provider with a
#                    `groups` claim. PROD-ONLY; wiring lands with the Authelia rollout.
AUTH_MODE=local

# Admin credentials (mono-user v1, used when AUTH_MODE=local)
ADMIN_USERNAME=admin
# Plaintext fallback (dev only). Leave ADMIN_PASSWORD_HASH empty to use this.
ADMIN_PASSWORD=admin
# Preferred: bcrypt hash of the admin password. When set, it takes precedence over
# ADMIN_PASSWORD and the plaintext value is ignored.
# Generate with:
#   docker compose run --rm api python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@localhost

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API_READ=60/minute
RATE_LIMIT_API_WRITE=30/minute
RATE_LIMIT_EXPENSIVE=2/hour

# CSRF Protection
# Generate with: openssl rand -hex 32
CSRF_SECRET_KEY=generate_csrf_secret_with_openssl_rand_hex_32
CSRF_TOKEN_LOCATION=header

# ==========================================
# RUN CONTROL (dashboard start/stop/kill + logs)
# ==========================================
# Directory holding per-run log files. The bot (supervisor) writes here and the
# API mounts it read-only to serve GET /runs/{id}/logs. Must match the volume
# target in docker-compose (default /var/log/trader-bot).
BOT_LOGS_DIR=/var/log/trader-bot
# Max log lines returned by the logs endpoint.
RUN_LOGS_MAX_LINES=100
# Max simultaneously active backtests (enforced by both the API and supervisor).
MAX_CONCURRENT_BACKTESTS=2

# ==========================================
# TRAEFIK & DOMAINS (PRODUCTION ONLY)
# ==========================================
# NOTE: Traefik is NOT used in development (docker-compose.yml)
# Development uses direct port access: localhost:8000, localhost:5173
# Traefik is ONLY used in production (docker-compose.prod.yml)

# Production domains (used in docker-compose.prod.yml)
DOMAIN_DASHBOARD=bot.yourdomain.com
DOMAIN_API=api.yourdomain.com
# Authelia (future, prod-only OIDC provider) — e.g. auth.trader.derveloy.eu
# DOMAIN_AUTH=auth.yourdomain.com

# HTTPS via Let's Encrypt (production only)
ACME_EMAIL=your-email@example.com

# ==========================================
# DISCORD NOTIFICATIONS
# ==========================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Notification settings (true/false toggles)
NOTIFY_TRADE_OPENED=true
NOTIFY_TRADE_CLOSED=true
NOTIFY_ORDER_FILLED=true
NOTIFY_RUN_COMPLETED=true
NOTIFY_CRITICAL_ERROR=true
NOTIFY_BOT_STOPPED=true
NOTIFY_QUOTA_REACHED=true
NOTIFY_OPTIMIZATION_COMPLETE=true

# Rate limiting (prevent spam)
DISCORD_RATE_LIMIT_MESSAGES=10
DISCORD_RATE_LIMIT_PERIOD_SECONDS=60

# ==========================================
# EXTERNAL GRAFANA CONNECTION (OPTIONAL)
# ==========================================
# Grafana is now hosted externally on a separate server.
# If you want the dashboard to link to external Grafana, set VITE_GRAFANA_BASE_URL.
# The external Grafana should connect to PostgreSQL using:
#   Host: <this-server-ip>:5432
#   Database: ${POSTGRES_DB}
#   User: ${POSTGRES_USER}
#   Password: ${POSTGRES_PASSWORD}
#
# VITE_GRAFANA_BASE_URL=https://your-external-grafana.com

# ==========================================
# TRADING BOT CONFIGURATION
# ==========================================
# Strategy parameters
STRATEGY_ENTRY_THRESHOLD=0.6  # Score threshold to enter position [-1, 1]
STRATEGY_EXIT_THRESHOLD=-0.3  # Score threshold to exit position [-1, 1]
STRATEGY_CONFIRMATION_CANDLES=2  # Anti-repainting: confirm on N candles

# Risk management
RISK_MAX_TRADES_PER_DAY=5
RISK_MAX_EXPOSURE_PERCENT=30.0  # Max % of capital exposed
RISK_POSITION_SIZE_MODE=confidence  # fixed, confidence, risk_atr
RISK_FIXED_SIZE_USDT=100.0
RISK_ATR_MULTIPLIER=2.0
RISK_CAPITAL_RISK_PERCENT=1.0  # % of capital to risk per trade (ATR mode)

# Stop-loss / Take-profit
SL_MODE=atr  # atr, fixed
SL_ATR_MULTIPLIER=2.0
SL_FIXED_PERCENT=2.0
TP_MODE=atr  # atr, fixed
TP_ATR_MULTIPLIER=3.0
TP_FIXED_PERCENT=4.0

# Cooldown
COOLDOWN_AFTER_TRADE_SECONDS=3600  # 1 hour

# ==========================================
# OPTUNA OPTIMIZATION
# ==========================================
OPTUNA_N_TRIALS=100
OPTUNA_N_JOBS=1  # Parallel trials (-1 for all CPUs)
OPTUNA_SAMPLER=TPE  # TPE, Random, Grid
OPTUNA_PRUNER=MedianPruner  # MedianPruner, HyperbandPruner

# Walk-forward analysis
OPTUNA_WALK_FORWARD_SPLITS=4
OPTUNA_WALK_FORWARD_TRAIN_RATIO=0.75

# ==========================================
# BACKTESTING
# ==========================================
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_COMMISSION_PERCENT=0.1  # Binance spot taker fee (0.1%)

# Coherence check tolerance between vectorbt and custom backtester
BACKTEST_COHERENCE_TOLERANCE_PERCENT=2.0

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/trader-bot/app.log

# ==========================================
# API SERVER (FastAPI)
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000

# Development settings
API_RELOAD=true  # Auto-reload on code changes (disable in prod)
API_WORKERS=1    # Single worker for dev (prod: 4+ workers)

# CORS Configuration
# Development: Multiple localhost ports for dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Production: MUST use exact dashboard domain (where the frontend is served from)
# Example: If dashboard is at trader.derveloy.eu, use:
# CORS_ORIGINS=https://trader.derveloy.eu

# ==========================================
# DASHBOARD (Vue.js)
# ==========================================
# Development URLs (direct port access, no Traefik)
VITE_API_BASE_URL=http://localhost:8000

# Production URLs (for production deployment with Traefik)
# CRITICAL: Must include protocol (https://) or axios will treat it as a relative path
# VITE_API_BASE_URL=https://api.yourdomain.com

# ==========================================
# DEVELOPMENT FLAGS
# ==========================================
DEBUG=true       # Enable debug mode (disable in prod)
HOT_RELOAD=true  # Enable hot reload for Docker (disable in prod)

# Development service URLs (for reference)
# Dashboard: http://localhost:5173
# API: http://localhost:8000
# PostgreSQL: localhost:5432 (exposed for external Grafana)
