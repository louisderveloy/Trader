# Placeholder — the REAL server.key is gitignored (db/certificates/*.key).
#
# This is the PostgreSQL server's TLS private key, used ONLY in production
# (docker-compose.prod.yml). It is generated alongside server.crt:
#   sudo openssl req -new -x509 -days 825 -nodes -text \
#     -out server.crt -keyout server.key \
#     -subj "/CN=<your-postgres-host-or-ip>"
#
# CRITICAL — permissions, or postgres refuses to start (key mounted read-only):
#   sudo chown 70:70 server.key && sudo chmod 600 server.key
#   # alternatively: chown to the container postgres user + chmod 600
#
# 70 is the userid of the user used in the timescaledb image. 
#
# The resulting server.key is a PEM file:
#   -----BEGIN PRIVATE KEY-----
#   ...
#   -----END PRIVATE KEY-----
#
# NEVER commit the real key.
