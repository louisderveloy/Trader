# Production Dockerfile for Vue.js dashboard
# Multi-stage build: build Vue.js app, then serve with nginx

# ==========================================
# Stage 1: Build Vue.js application
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including devDependencies for build)
RUN npm ci

# Copy application code
COPY . .

# Build arguments for environment variables (baked into the bundle at build time)
ARG VITE_API_BASE_URL
ARG VITE_GRAFANA_BASE_URL
# Auth mode: 'authelia_oidc' in prod so the dashboard redirects to Authelia.
ARG VITE_AUTH_MODE=authelia_oidc
ENV VITE_AUTH_MODE=${VITE_AUTH_MODE}

# Build for production
RUN npm run build

# ==========================================
# Stage 2: Serve with nginx (non-root, security review #7)
# ==========================================
# nginx-unprivileged runs as uid 101 ('nginx') and listens on 8080 instead of the
# privileged port 80 — no root in the serving container.
FROM nginxinc/nginx-unprivileged:alpine

# The base image ends on USER 101; switch to root for the config/file swap, then
# drop back to the unprivileged user for the runtime.
USER root

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config with security headers (listens on 8080)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose the unprivileged port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/health || exit 1

# Run as the unprivileged nginx user (uid 101)
USER nginx

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
